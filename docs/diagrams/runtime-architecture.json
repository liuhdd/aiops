  "cards": [
    {
      "dot": "cyan",
      "title": "触发与回溯",
      "items": [
        "Simulator 按 SIM_INTERVAL_SECONDS 造告警并直接 eng.Run",
        "triage 同设备同指标去重，已完成运行标记 skipped",
        "rca 报 Gaps 时回溯重跑 evidence/rca/recommend（≤ 2 轮）"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与并发",
      "items": [
        "各阶段经 st.Store 读写，全局⊃设备⊃任务作用域隔离",
        "coordinator per-device 串行锁，30s 超时标记 degraded",
        "SQLite 单写连接规避 SQLITE_BUSY"
      ]
    },
    {
      "dot": "violet",
      "title": "前端与推送",
      "items": [
        "App.tsx 以 view state 切换三视图，ChatAssistant 常驻",
        "engine.Publish 广播 stage/run，main.go 转发 alert",
        "ws.ts 订阅 /ws 局部刷新，chat 可触发流水线"
      ]
    }
  ]
